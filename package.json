{
  "name": "drive-zip",
  "version": "1.0.0",
  "description": "Download Google Drive files and folders into a single ZIP",
  "author": "Drive to one ZIP <noreply@example.com>",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "bundle": "node bundle.mjs",
    "dist": "node bundle.mjs && electron-builder --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.example.drivezip",
    "productName": "Drive to one ZIP",
    "artifactName": "DriveZip-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "server.bundle.mjs",
      "defaults.json",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
